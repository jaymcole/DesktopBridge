# Shared bearer token for ALL units and this bridge. Server-side only; never sent to the browser.
TOKEN=change-me-to-a-long-random-secret

# Port this bridge listens on (unit self-registration + the app's /bridge proxy).
# MUST differ from the HouseGraph web server's port (8080), or they collide on
# startup. The app reaches this via the reverse proxy, not directly.
PORT=3000

# How often (ms) the reconciliation loop polls each known unit's GET /health.
POLL_INTERVAL_MS=60000

# A unit not seen (mDNS / register / successful poll) for this long (ms) is marked stale.
STALE_AFTER_MS=900000

# Allowed CORS origin(s) for the React UI. Comma-separate multiple origins
# (e.g. the LAN host + the dev server). Use "*" to allow any (not recommended).
UI_ORIGIN=http://accontroller.local:8080,http://localhost:5173
