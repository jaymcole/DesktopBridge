# Shared bearer token for ALL units and this bridge. Server-side only; never sent to the browser.
TOKEN=change-me-to-a-long-random-secret

# Port this bridge listens on (unit self-registration + the app's /bridge proxy).
# MUST differ from the HouseGraph web server's port (8080), or they collide on
# startup. The app reaches this via the reverse proxy, not directly.
PORT=3000

# How often (ms) the reconciliation loop polls each known unit. This is a
# liveness + reboot-reconcile backstop, NOT the latency path: units push remote
# presses to POST /observed instantly. Keep it gentle — an ESP32 has only a
# handful of TCP sockets and a new connection per poll can exhaust them, stalling
# for seconds if polled too often. 15s keeps the unit healthy and responsive.
POLL_INTERVAL_MS=15000

# Timeout (ms) for the bridge's read-only POLLS of a unit (health + config).
# Kept short so a rare stalled poll fails fast instead of blocking a tick for
# ~10s. On a healthy LAN a unit answers these in well under 200ms.
DEVICE_TIMEOUT_MS=2000

# Timeout (ms) for calls that make a unit DO something: POST /config, /resend
# and /identify. These are legitimately slow and must NOT share the poll budget
# above. /config and /resend transmit an IR burst and then verify it by reading
# their own emission back, which reaches ~2.4s when a command needs its full
# retry allowance; /identify blinks the unit's LED for ~3s before answering.
# Set too low, the unit still applies the command but the bridge records the
# push as failed, leaving stale desired state and a false drift badge in the UI.
DEVICE_COMMAND_TIMEOUT_MS=8000

# A unit not seen (mDNS / register / poll / observed push) for this long (ms) is
# marked offline. Set just above POLL_INTERVAL_MS so one missed check-in is
# tolerated but a second flips it offline: with a 15s poll, ~35s allows a single
# miss and trips on the next. MUST exceed POLL_INTERVAL_MS or a unit flips offline
# between polls.
OFFLINE_AFTER_MS=35000

# Allowed CORS origin(s) for the React UI. Comma-separate multiple origins
# (e.g. the LAN host + the dev server). Use "*" to allow any (not recommended).
UI_ORIGIN=http://accontroller.local:8080,http://localhost:5173
